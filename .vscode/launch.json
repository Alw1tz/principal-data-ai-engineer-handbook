{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: build.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug: check_links.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/check_links.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug: new_chapter.py (edit args below)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/new_chapter.py",
      "args": ["spark", "example-chapter", "--title", "Example Chapter"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug: mark_complete.py on current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/mark_complete.py",
      "args": ["${relativeFile}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
